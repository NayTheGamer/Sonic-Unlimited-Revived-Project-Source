    6154/   15C20 :                     ; ---------------------------------------------------------------------------
    6155/   15C20 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    6156/   15C20 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    6157/   15C20 :                     ; Pointers to said raw data are dummied out.
    6158/   15C20 :                     ; Curiously, an example of the original 'raw' data that this was intended
    6159/   15C20 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    6160/   15C20 :                     ; ---------------------------------------------------------------------------
    6161/   15C20 :                     
    6162/   15C20 : =$76DA6              RawColBlocks		equ CollArray1
    6163/   15C20 : =$76DA6              ConvRowColBlocks	equ CollArray1
    6164/   15C20 :                     
    6165/   15C20 :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
    6166/   15C20 :                     
    6167/   15C20 :                     
    6168/   15C20 :                     ConvertCollisionArray:
    6169/   15C20 : 4E75                		rts	
    6170/   15C22 :                     ; ---------------------------------------------------------------------------
    6171/   15C22 :                     		; The raw format stores the collision data column by column for the normal collision array.
    6172/   15C22 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    6173/   15C22 : 43F9 0007 6DA6      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    6174/   15C28 : 45F9 0007 6DA6      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    6175/   15C2E :                     
    6176/   15C2E : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    6177/   15C32 :                     
    6178/   15C32 :                     .blockLoop:
    6179/   15C32 : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    6180/   15C34 :                     
    6181/   15C34 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    6182/   15C38 :                     
    6183/   15C38 :                     .columnLoop:
    6184/   15C38 : 7800                		moveq	#0,d4
    6185/   15C3A :                     
    6186/   15C3A : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    6187/   15C3E :                     
    6188/   15C3E :                     .rowLoop:
    6189/   15C3E : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    6190/   15C40 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6191/   15C42 : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6192/   15C44 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6193/   15C48 :                     
    6194/   15C48 : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6195/   15C4A : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6196/   15C4E : 5345                		subq.w	#1,d5			; Get next bit in the row
    6197/   15C50 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6198/   15C54 :                     
    6199/   15C54 : D2FC 0020           		adda.w	#2*16,a1		; Next block
    6200/   15C58 : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    6201/   15C5C :                     
    6202/   15C5C :                     		; This then converts the collision data into the final collision arrays
    6203/   15C5C : 43F9 0007 6DA6      		lea	(ConvRowColBlocks).l,a1
    6204/   15C62 : 45F9 0007 7DA6      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
    6205/   15C68 : 6178                		bsr.s	.convertArray
    6206/   15C6A : 43F9 0007 6DA6      		lea	(RawColBlocks).l,a1
    6207/   15C70 : 45F9 0007 6DA6      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
    6208/   15C76 :                     
    6209/   15C76 :                     
    6210/   15C76 :                     .convertArray:
    6211/   15C76 : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
    6212/   15C7A :                     
    6213/   15C7A :                     .processLoop:
    6214/   15C7A : 7400                		moveq	#0,d2
    6215/   15C7C : 323C 000F           		move.w	#$F,d1
    6216/   15C80 : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
    6217/   15C82 : 6790                		beq.s	.noCollision		; Branch if there's no collision in this column
    6218/   15C84 : 6B78                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
    6219/   15C86 :                     
    6220/   15C86 :                     	; Here we count, starting from the bottom, how many pixels tall
    6221/   15C86 :                     	; the collision in this column is.
    6222/   15C86 :                     .processColumnLoop1:
    6223/   15C86 : E248                		lsr.w	#1,d0
    6224/   15C88 : 646E                		bhs.s	.pixelNotSolid1
    6225/   15C8A : 5202                		addq.b	#1,d2
    6226/   15C8C :                     
    6227/   15C8C :                     .pixelNotSolid1:
    6228/   15C8C : 51C9 FFF8           		dbf	d1,.processColumnLoop1
    6229/   15C90 :                     
    6230/   15C90 : 6084                		bra.s	.columnProcessed
    6231/   15C92 :                     ; ===========================================================================
    6232/   15C92 :                     
