(2)   80/       0 :                     		dc.b	pitch
(2)   81/       0 :                     	else
(2)   82/       0 :                     		dc.b	(pitch+psgdelta)&$FF
(2)   83/       0 :                     	endif
(2)   84/       0 :                     	endm
