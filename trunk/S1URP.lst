(1)   43/   863F4 :                     	; Clownacy | Pretty large rearrangements have been made here for the
(1)   44/   863F4 :                     	; Sonic 2-style selective PAL mode. With S2's driver, if the drowning music played on a PAL
(1)   45/   863F4 :                     	; system, the drowning theme would play at 50fps speed, or 'PAL speed'
(1)   46/   863F4 :                     	; this code is part of that feature's replication
(1)   47/   863F4 : 082E 0005 03BD      	btst	#f_pal,SMPS_RAM.bitfield1(a6)				; is this a PAL console?
(1)   48/   863FA : 6716                	beq.s	.skip_double_update					; if not, branch
(1)   49/   863FC : 082E 0002 03A9      	btst	#f_force_pal_tempo,SMPS_RAM.variables.bitfield2(a6)	; is this song forced to play slow on PAL consoles?
(1)   50/   86402 : 660E                	bne.s	.skip_double_update					; if so, skip the double-update
(1)   51/   86404 : 532E 03A5           	subq.b	#1,SMPS_RAM.variables.v_pal_audio_countdown(a6)		; subtract 1 from the PAL countdown
(1)   52/   86408 : 6608                	bne.s	.skip_double_update					; if the PAL countdown is not 0, we are not ready to double-update, branch
(1)   53/   8640A : 1D7C 0005 03A5      	move.b	#5,SMPS_RAM.variables.v_pal_audio_countdown(a6)		; if the countdown is now at 0, reset the counter...
