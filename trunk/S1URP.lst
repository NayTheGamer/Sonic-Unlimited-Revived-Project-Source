(2)   51/       0 :                     ; Conversion macros and functions
(2)   52/       0 :                     
(2)   53/       0 :                     conv0To256  function n,((n==0)<<8)|n
(2)   54/       0 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)   55/       0 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)   56/       0 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)   57/       0 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)   58/       0 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)   59/       0 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)   60/       0 :                     
(2)   61/       0 :                     convertMainTempoMod macro mod
(2)   62/       0 :                     	if SourceDriver>=3
(2)   63/       0 :                     		dc.b	mod
(2)   64/       0 :                     	elseif SourceDriver==1
(2)   65/       0 :                     		if mod==1
(2)   66/       0 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)   67/       0 :                     		endif
(2)   68/       0 :                     		dc.b	s1TempotoS3(mod)
(2)   69/       0 :                     	elseif SourceDriver==2
(2)   70/       0 :                     		if mod==0
(2)   71/       0 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)   72/       0 :                     		endif
(2)   73/       0 :                     		dc.b	s2TempotoS3(mod)
(2)   74/       0 :                     	endif
(2)   75/       0 :                     	endm
(2)   76/       0 :                     
(2)   77/       0 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
