(1)   17/       0 :                     		else
(1)   18/       0 :                     		move.l	#($40000000+(((loc)&$3FFF)<<16)+(((loc)&$C000)>>14)),controlport
(1)   19/       0 :                     		endif
(1)   20/       0 :                     		endm		
