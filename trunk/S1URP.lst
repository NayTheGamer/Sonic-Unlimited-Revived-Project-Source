(2)  538/       0 :                     
(2)  539/       0 :                     ; Voices - Amplitude Modulation
(2)  540/       0 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  541/       0 :                     ; were the Amplitude Modulation.
(2)  542/       0 :                     ; According to several docs, however, it's actually the high bit.
(2)  543/       0 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  544/       0 :                     	if SMPS2ASMVer==0
(2)  545/       0 :                     vcAM1 set op1<<5
(2)  546/       0 :                     vcAM2 set op2<<5
(2)  547/       0 :                     vcAM3 set op3<<5
(2)  548/       0 :                     vcAM4 set op4<<5
(2)  549/       0 :                     	else
(2)  550/       0 :                     vcAM1 set op1<<7
(2)  551/       0 :                     vcAM2 set op2<<7
(2)  552/       0 :                     vcAM3 set op3<<7
(2)  553/       0 :                     vcAM4 set op4<<7
(2)  554/       0 :                     	endif
(2)  555/       0 :                     	endm
(2)  556/       0 :                     
(2)  557/       0 :                     ; Voices - First Decay Rate
(2)  558/       0 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  559/       0 :                     vcD1R1 set op1
(2)  560/       0 :                     vcD1R2 set op2
(2)  561/       0 :                     vcD1R3 set op3
(2)  562/       0 :                     vcD1R4 set op4
(2)  563/       0 :                     	endm
(2)  564/       0 :                     
(2)  565/       0 :                     ; Voices - Second Decay Rate
(2)  566/       0 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  567/       0 :                     vcD2R1 set op1
(2)  568/       0 :                     vcD2R2 set op2
(2)  569/       0 :                     vcD2R3 set op3
(2)  570/       0 :                     vcD2R4 set op4
(2)  571/       0 :                     	endm
(2)  572/       0 :                     
(2)  573/       0 :                     ; Voices - Decay Level
(2)  574/       0 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  575/       0 :                     vcDL1 set op1
(2)  576/       0 :                     vcDL2 set op2
(2)  577/       0 :                     vcDL3 set op3
(2)  578/       0 :                     vcDL4 set op4
(2)  579/       0 :                     	endm
(2)  580/       0 :                     
(2)  581/       0 :                     ; Voices - Release Rate
(2)  582/       0 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  583/       0 :                     vcRR1 set op1
(2)  584/       0 :                     vcRR2 set op2
(2)  585/       0 :                     vcRR3 set op3
(2)  586/       0 :                     vcRR4 set op4
(2)  587/       0 :                     	endm
(2)  588/       0 :                     
(2)  589/       0 :                     ; Voices - Total Level
(2)  590/       0 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  591/       0 :                     ; but later versions leave it up to the user.
(2)  592/       0 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  593/       0 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  594/       0 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  595/       0 :                     ; SMPS Z80 does the opposite.
(2)  596/       0 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  597/       0 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  598/       0 :                     ; what we do, so we just print a warning.
(2)  599/       0 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  600/       0 :                     vcTL1 set op1
(2)  601/       0 :                     vcTL2 set op2
(2)  602/       0 :                     vcTL3 set op3
(2)  603/       0 :                     vcTL4 set op4
(2)  604/       0 :                     	dc.b	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  605/       0 :                     ;   0     1     2     3     4     5     6     7
(2)  606/       0 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  607/       0 :                     	if SourceSMPS2ASM==0
(2)  608/       0 :                     vcTLMask4 set ((vcAlgorithm==7)<<7)
(2)  609/       0 :                     vcTLMask3 set ((vcAlgorithm>=4)<<7)
(2)  610/       0 :                     vcTLMask2 set ((vcAlgorithm>=5)<<7)
(2)  611/       0 :                     vcTLMask1 set $80
(2)  612/       0 :                     	else
(2)  613/       0 :                     vcTLMask4 set 0
(2)  614/       0 :                     vcTLMask3 set 0
(2)  615/       0 :                     vcTLMask2 set 0
(2)  616/       0 :                     vcTLMask1 set 0
(2)  617/       0 :                     	endif
(2)  618/       0 :                     
(2)  619/       0 :                     	if SourceDriver<3
(2)  620/       0 :                     vcTLMask4 set ((vcAlgorithm==7)<<7)
(2)  621/       0 :                     vcTLMask3 set ((vcAlgorithm>=4)<<7)
(2)  622/       0 :                     vcTLMask2 set ((vcAlgorithm>=5)<<7)
(2)  623/       0 :                     vcTLMask1 set $80
(2)  624/       0 :                     vcTL1 set vcTL1&$7F
(2)  625/       0 :                     vcTL2 set vcTL2&$7F
(2)  626/       0 :                     vcTL3 set vcTL3&$7F
(2)  627/       0 :                     vcTL4 set vcTL4&$7F
(2)  628/       0 :                     	endif
(2)  629/       0 :                     
(2)  630/       0 :                     	dc.b	(vcDT4<<4)+vcCF4 ,(vcDT2<<4)+vcCF2 ,(vcDT3<<4)+vcCF3 ,(vcDT1<<4)+vcCF1
(2)  631/       0 :                     	dc.b	vcTL4|vcTLMask4  ,vcTL2|vcTLMask2  ,vcTL3|vcTLMask3  ,vcTL1|vcTLMask1
(2)  632/       0 :                     	dc.b	(vcRS4<<6)+vcAR4 ,(vcRS2<<6)+vcAR2 ,(vcRS3<<6)+vcAR3 ,(vcRS1<<6)+vcAR1
(2)  633/       0 :                     	dc.b	vcAM4|vcD1R4     ,vcAM2|vcD1R2     ,vcAM3|vcD1R3     ,vcAM1|vcD1R1
(2)  634/       0 :                     	dc.b	vcD2R4           ,vcD2R2           ,vcD2R3           ,vcD2R1
(2)  635/       0 :                     	dc.b	(vcDL4<<4)+vcRR4 ,(vcDL2<<4)+vcRR2 ,(vcDL3<<4)+vcRR3 ,(vcDL1<<4)+vcRR1
(2)  636/       0 :                     	endm
