    6698/   1667C :                     Map_Disc:	include	"_maps/Running Disc.asm"
(1)    1/   1667C :                     ; ---------------------------------------------------------------------------
(1)    2/   1667C :                     ; Sprite mappings - disc that you run around (SBZ)
(1)    3/   1667C :                     ; (It's just a small blob that moves around in a circle. The disc itself is
