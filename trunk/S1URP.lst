    6234/   15C92 : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
    6235/   15C96 : 6778                		beq.s	.entireColumnSolid	; Branch if so
    6236/   15C98 :                     
    6237/   15C98 :                     	; Here we count, starting from the top, how many pixels tall
    6238/   15C98 :                     	; the collision in this column is (the resulting number is negative).
    6239/   15C98 :                     .processColumnLoop2:
    6240/   15C98 : E348                		lsl.w	#1,d0
    6241/   15C9A : 646E                		bhs.s	.pixelNotSolid2
    6242/   15C9C : 5302                		subq.b	#1,d2
    6243/   15C9E :                     
    6244/   15C9E :                     .pixelNotSolid2:
    6245/   15C9E : 51C9 FFF8           		dbf	d1,.processColumnLoop2
    6246/   15CA2 :                     
    6247/   15CA2 : 6072                		bra.s	.columnProcessed
    6248/   15CA4 :                     ; ===========================================================================
    6249/   15CA4 :                     
    6250/   15CA4 :                     .entireColumnSolid:
    6251/   15CA4 : 303C 0010           		move.w	#$10,d0
    6252/   15CA8 :                     
    6253/   15CA8 :                     .noCollision:
    6254/   15CA8 : 3400                		move.w	d0,d2
    6255/   15CAA :                     
    6256/   15CAA :                     .columnProcessed:
    6257/   15CAA : 14C2                		move.b	d2,(a2)+		; Store column collision height
    6258/   15CAC : 51CB FFCC           		dbf	d3,.processLoop
    6259/   15CB0 :                     
    6260/   15CB0 : 4E75                		rts	
    6261/   15CB2 :                     
    6262/   15CB2 :                     ; End of function ConvertCollisionArray
