(2)  101/       0 :                     	message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  102/       0 :                     	endif
(2)  103/       0 :                     	endif
(2)  104/       0 :                     
(2)  105/       0 :                     	endm
