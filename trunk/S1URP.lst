(2)   65/       0 :                     ; Macros to wait for when the YM2612 isn't busy.
(2)   66/       0 :                     ;
(2)   67/       0 :                     ; Might as well document this a little:
(2)   68/       0 :                     ; When you write to the YM2612's data ports, it takes 2 YM cycles
(2)   69/       0 :                     ; for the BUSY flag to set itself. A YM-cycle takes 6 cycles on the
(2)   70/       0 :                     ; 68k, so we wait 12 cycles before checking the flag.
(2)   71/       0 :                     ;
(2)   72/       0 :                     ; The BUSY flag is seemingly hardcoded to last 32 YM cycles, or 192
(2)   73/       0 :                     ; 68k cycles, so theoretically I could just burn a bunch of cycles
(2)   74/       0 :                     ; here with ineffective instructions, but I think checking the flag
(2)   75/       0 :                     ; would let me be a bit more precise (I don't know exactly *when* in
(2)   76/       0 :                     ; the 12-cycle instruction the YM2612 is actually written to).
(2)   77/       0 :                     ; ---------------------------------------------------------------------------
(2)   78/       0 :                     SMPS_delayYM macro target
(2)   79/       0 :                     	nop		; 4(1/0)
(2)   80/       0 :                     	nop		; 4(1/0)
(2)   81/       0 :                     	nop		; 4(1/0)
(2)   82/       0 :                     	endm
(2)   83/       0 :                     
(2)   84/       0 :                     SMPS_waitYM macro target
(2)   85/       0 :                     .loop:	tst.b	(a0)	; 8(2/0)
(2)   86/       0 :                     	bmi.s	.loop	; 10(2/0) | 8(1/0)
(2)   87/       0 :                     	endm
(2)   88/       0 :                     
