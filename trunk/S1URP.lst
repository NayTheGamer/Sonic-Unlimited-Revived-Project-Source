(1) 3399/   87AC8 :                     ; ===========================================================================
(1) 3400/   87AC8 :                     ; Sets track volume.
(1) 3401/   87AC8 :                     ;
(1) 3402/   87AC8 :                     ; Has one parameter byte, the volume.
(1) 3403/   87AC8 :                     ;
(1) 3404/   87AC8 :                     ; For FM tracks, this is a 7-bit value from 0 (lowest volume) to 127 (highest
(1) 3405/   87AC8 :                     ; volume). The value is XOR'ed with 7Fh before being sent, then stripped of the
(1) 3406/   87AC8 :                     ; sign bit. The volume change takes effect immediately.
(1) 3407/   87AC8 :                     ;
(1) 3408/   87AC8 :                     ; For PSG tracks, this is a 4-bit value ranging from 8 (lowest volume) to 78h
(1) 3409/   87AC8 :                     ; (highest volume). The value is shifted 3 bits to the right, XOR'ed with 0Fh
(1) 3410/   87AC8 :                     ; and AND'ed with 0Fh before being uploaded, so the sign bit and the lower 3
(1) 3411/   87AC8 :                     ; bits are discarded.
(1) 3412/   87AC8 :                     ;
(1) 3413/   87AC8 :                     cfSetVolume:
(1) 3414/   87AC8 : 101C                	move.b	(a4)+,d0			; Load parameter byte
(1) 3415/   87ACA : 4600                	not.b	d0				; Invert bits
(1) 3416/   87ACC : 4A2D 0001           	tst.b	SMPS_Track.VoiceControl(a5)	; Is this a psg track?
(1) 3417/   87AD0 : 6A0A                	bpl.s	.FMVolume			; If not, branch
(1) 3418/   87AD2 : 0200 0078           	andi.b	#$78,d0
(1) 3419/   87AD6 : 1B40 0005           	move.b	d0,SMPS_Track.Volume(a5)	; Write volume
(1) 3420/   87ADA : 4E75                	rts
