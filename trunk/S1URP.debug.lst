    2855/    4FAA :                             .__data:
    2855/    4FAA :    (MACRO-4)                         __FSTRING_GenerateDecodedString "ResetDMAQueue/Transfers Function"
    2855/    4FAA :                     
    2855/    4FAA : =$0                          .__lpos:        set             0               ; start position
    2855/    4FAA : =$FFFFFFFFFFFFFFFF           .__pos: set             strstr("ResetDMAQueue/Transfers Function", "%<")
    2855/    4FAA :                     
    2855/    4FAA :                             while (.__pos>=0)
    2855/    4FAA :                     
    2855/    4FAA :                                     ; Write part of "ResetDMAQueue/Transfers Function" before % token
    2855/    4FAA :                                     if (.__pos-.__lpos>0)
    2855/    4FAA :                                             dc.b    substr("ResetDMAQueue/Transfers Function", .__lpos, .__pos-.__lpos)
    2855/    4FAA :                                     endif
    2855/    4FAA :                     
    2855/    4FAA :                                     ; Retrive expression in brakets following % char
    2855/    4FAA :                             .__endpos:      set             strstr(substr("ResetDMAQueue/Transfers Function",.__pos+1,0),">")+.__pos+1 
    2855/    4FAA :                                     if (.__endpos<=.__pos) ; Fix bizzare AS bug as stsstr() fails to check the last character of "ResetDMAQueue/Transfers Function"
    2855/    4FAA :                                             .__endpos:      set             strlen("ResetDMAQueue/Transfers Function")-1
    2855/    4FAA :                                     endif
