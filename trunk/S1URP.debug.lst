(2)  516/     9C8 : 4F                  	ld	c,a
(2)  517/     9C9 :                     	; Point to a single silent sample
(2)  518/     9C9 : 21 0A 0A            	ld	hl,zMuteSample
(2)  519/     9CC :                     	; Set the current value to silence, to prevent audio popping
(2)  520/     9CC : 78                  	ld	a,b	; b is 80h
(2)  521/     9CD : C9                  	ret
(2)  522/     9CE :                     
(2)  523/     9CE :                     zSample1NextBank:
(2)  524/     9CE : 08                  	ex	af,af'
(2)  525/     9CF : E5                  	push	hl
(2)  526/     9D0 : 21 FC 0F            	ld	hl,zSample1Bank
(2)  527/     9D3 : DD 21 06 01         	ld	ix,zSample1SelfModifiedCode
(2)  528/     9D7 : 18 09               	jr	zSample2NextBank.go
(2)  529/     9D9 :                     
(2)  530/     9D9 :                     zSample2NextBank:
(2)  531/     9D9 : 08                  	ex	af,af'
(2)  532/     9DA : E5                  	push	hl
(2)  533/     9DB :                     	; Grab bank value and increment it
(2)  534/     9DB : 21 FD 0F            	ld	hl,zSample2Bank
(2)  535/     9DE : DD 21 A9 04         	ld	ix,zSample2SelfModifiedCode
(2)  536/     9E2 :                     .go:
(2)  537/     9E2 : C5                  	push	bc
(2)  538/     9E3 : 34                  	inc	(hl)
(2)  539/     9E4 :                     	; Self-modify the bankswitch code to suit the new bank value
(2)  540/     9E4 : 7E                  	ld	a,(hl)
(2)  541/     9E5 : CD F9 09            	call	zChangeBankswitch
(2)  542/     9E8 :                     	; Switch to the new bank
(2)  543/     9E8 : 7E                  	ld	a,(hl)
(2)  544/     9E9 : 21 01 60            	ld	hl,zBankRegister
(2)  545/     9EC : 06 08               	ld	b,8
(2)  546/     9EE :                     .loop:
(2)  547/     9EE : 77                  	ld	(hl),a
(2)  548/     9EF : 1F                  	rra
(2)  549/     9F0 : 10 FC               	djnz	.loop
(2)  550/     9F2 :                     
(2)  551/     9F2 : 74                  	ld	(hl),h
(2)  552/     9F3 :                     	; Restore backed-up registers
(2)  553/     9F3 : C1                  	pop	bc
(2)  554/     9F4 : E1                  	pop	hl
(2)  555/     9F5 :                     	; HL has wrapped around to 0000h, so bump it back to the 68k window
(2)  556/     9F5 : CB FC               	set	7,h
(2)  557/     9F7 : 08                  	ex	af,af'
(2)  558/     9F8 : C9                  	ret
(2)  559/     9F9 :                     
(2)  560/     9F9 :                     zChangeBankswitch:
(2)  561/     9F9 : 06 08               	ld	b,8
(2)  562/     9FB :                     .loop:
(2)  563/     9FB : DD 36 03 74         	ld	(ix+zSample1Bankswitch-zSample1SelfModifiedCode),74h	; ld (hl),h
(2)  564/     9FF : 0F                  	rrca
(2)  565/     A00 : 30 03               	jr	nc,.skip
(2)  566/     A02 : DD 34 03            	inc	(ix+zSample1Bankswitch-zSample1SelfModifiedCode)	; ld (hl),l
(2)  567/     A05 :                     .skip:
(2)  568/     A05 : DD 23               	inc	ix
(2)  569/     A07 : 10 F2               	djnz	.loop
(2)  570/     A09 : C9                  	ret
(2)  571/     A0A :                     
(2)  572/     A0A :                     zMuteSample:
(2)  573/     A0A : 80                  	db	80h	; The transistors that make up this particular byte of memory are going to hate me so much
(2)  574/     A0B :                     
(2)  575/     A0B : =43A4H               zDriverSampleRate = (3579545 * zBatchSize) / (zTotalCycles + zBatchSize * 30)	; 30 is the number of cycles per zOutputSample
(2)  576/     A0B : =0B0H                zActualCyclesPerSample = zTotalCycles / zBatchSize
(2)  577/     A0B :                     
(2)  611/     A0B :                     
(2)  612/     A0B : ALL                  	restore
(2)  613/     A0B :                     	padding off
