(1)  189/    1424 : 0241 0070           		andi.w	#$70,d1	; get repeat count for palette index
(1)  190/    1428 : 8E41                		or.w	d1,d7	; combine the two
(1)  191/    142A : 0240 000F           		andi.w	#$F,d0	; get the length of the code in bits
