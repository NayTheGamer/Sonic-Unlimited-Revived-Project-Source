    3688/    70A6 : 2C99                		move.l	(a1)+,(a6)	; Write top two tiles
    3689/    70A8 : D087                		add.l	d7,d0		; Next row
    3690/    70AA : 2A80                		move.l	d0,(a5)
    3691/    70AC : 2C99                		move.l	(a1)+,(a6)	; Write bottom two tiles
    3692/    70AE : 4E75                		rts	
