(1)   12/   FAFA2 :                     ; Debugger and Error handler blob
(1)   13/   FAFA2 :                     ; ---------------------------------------------------------------
(1)   14/   FAFA2 :                     
(1)   15/   FAFA2 :                     
(1)   16/   FAFA2 :                     ; ---------------------------------------------------------------
(1)   17/   FAFA2 :                     ; Exception vectors
(1)   18/   FAFA2 :                     ; ---------------------------------------------------------------
(1)   19/   FAFA2 :                     
(1)   23/   FAFA2 : =$0                  _eh_default:	equ	0
(1)   25/   FAFA2 :                     
(1)   26/   FAFA2 :                     ; ---------------------------------------------------------------
(1)   27/   FAFA2 :                     
(1)   28/   FAFA2 :                     BusError:
(1)   29/   FAFA2 : (MACRO)              	__ErrorMessage "BUS ERROR", _eh_default|_eh_address_error	
(1)   29/   FAFA2 :  (MACRO-2)                           __FSTRING_GenerateArgumentsCode "BUS ERROR"
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 : =$FFFFFFFFFFFFFFFF           .__pos: set     strstr("BUS ERROR","%<")             ; token position
(1)   29/   FAFA2 : =$0                          .__sp:  set             0                                               ; stack displacement
(1)   29/   FAFA2 : ="BUS ERROR"                 .__str: set             "BUS ERROR"
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                             ; Parse "BUS ERROR" itself
(1)   29/   FAFA2 :                             while (.__pos>=0)
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                             ; Find the last occurance "%<" in the "BUS ERROR"
(1)   29/   FAFA2 :                             while ( strstr(substr(.__str,.__pos+2,0),"%<")>=0 )
(1)   29/   FAFA2 :                                             .__pos:         set             strstr(substr(.__str,.__pos+2,0),"%<")+.__pos+2
(1)   29/   FAFA2 :                                     endm
(1)   29/   FAFA2 :                                     .__substr:      set             substr(.__str,.__pos,0)
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                     ; Retrive expression in brackets following % char
(1)   29/   FAFA2 :                             .__endpos:      set             strstr(.__substr,">")
(1)   29/   FAFA2 :                                     if (.__endpos<0) ; Fix bizzare AS bug as stsstr() fails to check the last character of "BUS ERROR"
(1)   29/   FAFA2 :                                             .__endpos:      set             strlen(.__substr)-1
(1)   29/   FAFA2 :                                     endif
(1)   29/   FAFA2 :                             .__midpos:      set             strstr(substr(.__substr,5,0)," ")
(1)   29/   FAFA2 :                             if ((.__midpos<0)||(.__midpos+5>.__endpos))
(1)   29/   FAFA2 :                                             .__midpos:      set             .__endpos
(1)   29/   FAFA2 :                                     else
(1)   29/   FAFA2 :                                             .__midpos:      set             .__midpos+5
(1)   29/   FAFA2 :                             endif
(1)   29/   FAFA2 :                                     .__type:                set             substr(.__substr,2,2)   ; .type
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                     ; Expression is an effective address (e.g. %(.w d0 hex) )
(1)   29/   FAFA2 :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
(1)   29/   FAFA2 :                                             .__operand:     set             substr(.__substr,5,.__midpos-5)                                         ; ea
(1)   29/   FAFA2 :                                             .__param:       set             substr(.__substr,.__midpos+1,.__endpos-.__midpos-1)             ; param
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                             if (.__type==".b")
(1)   29/   FAFA2 :                                                     subq.w  #2, sp
(1)   29/   FAFA2 :                                                     __FSTRING_PushArgument.b        .__operand,1(sp)
(1)   29/   FAFA2 :                                                     .__sp:  set             .__sp+2
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                             elseif (.__type==".w")
(1)   29/   FAFA2 :                                                     __FSTRING_PushArgument.w        .__operand,-(sp)
(1)   29/   FAFA2 :                                                     .__sp:  set             .__sp+2
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                             elseif (.__type==".l")
(1)   29/   FAFA2 :                                                     __FSTRING_PushArgument.l        .__operand,-(sp)
(1)   29/   FAFA2 :                                                     .__sp:  set             .__sp+4
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                             else
(1)   29/   FAFA2 :                                                     error "Unrecognized type in "BUS ERROR" operand: \{.__type}"
(1)   29/   FAFA2 :                                             endif
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                     endif
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                                     ; Cut "BUS ERROR"
(1)   29/   FAFA2 :                                     if (.__pos>0)
(1)   29/   FAFA2 :                                             .__str: set             substr(.__str, 0, .__pos)
(1)   29/   FAFA2 :                                             .__pos: set             strstr(.__str,"%<")
(1)   29/   FAFA2 :                                     else
(1)   29/   FAFA2 :                                             .__pos: set             -1
(1)   29/   FAFA2 :                                     endif
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 :                             endm
(1)   29/   FAFA2 :                     
(1)   29/   FAFA2 : 4EB9 000F B0E4                      jsr             MDDBG__ErrorHandler
(1)   29/   FAFA8 :  (MACRO-2)                           __FSTRING_GenerateDecodedString "BUS ERROR"
(1)   29/   FAFA8 :                     
(1)   29/   FAFA8 : =$0                          .__lpos:        set             0               ; start position
(1)   29/   FAFA8 : =$FFFFFFFFFFFFFFFF           .__pos: set             strstr("BUS ERROR", "%<")
(1)   29/   FAFA8 :                     
(1)   29/   FAFA8 :                             while (.__pos>=0)
(1)   29/   FAFA8 :                     
(1)   29/   FAFA8 :                                     ; Write part of "BUS ERROR" before % token
(1)   29/   FAFA8 :                                     if (.__pos-.__lpos>0)
(1)   29/   FAFA8 :                                             dc.b    substr("BUS ERROR", .__lpos, .__pos-.__lpos)
(1)   29/   FAFA8 :                                     endif
(1)   29/   FAFA8 :                     
(1)   29/   FAFA8 :                                     ; Retrive expression in brakets following % char
(1)   29/   FAFA8 :                             .__endpos:      set             strstr(substr("BUS ERROR",.__pos+1,0),">")+.__pos+1 
(1)   29/   FAFA8 :                                     if (.__endpos<=.__pos) ; Fix bizzare AS bug as stsstr() fails to check the last character of "BUS ERROR"
(1)   29/   FAFA8 :                                             .__endpos:      set             strlen("BUS ERROR")-1
(1)   29/   FAFA8 :                                     endif
(1)   29/   FAFA8 :                             .__midpos:      set             strstr(substr("BUS ERROR",.__pos+5,0)," ")+.__pos+5
(1)   29/   FAFA8 :                             if ((.__midpos<.__pos+5)||(.__midpos>.__endpos))
(1)   29/   FAFA8 :                                             .__midpos:      set             .__endpos
(1)   29/   FAFA8 :                             endif
(1)   29/   FAFA8 :                                     .__type:                set             substr("BUS ERROR",.__pos+1+1,2)             ; .type
