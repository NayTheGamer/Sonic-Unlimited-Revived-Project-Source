    6133/   15E78 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    6134/   15E78 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    6135/   15E78 :                     ; Pointers to said raw data are dummied out.
    6136/   15E78 :                     ; Curiously, an example of the original 'raw' data that this was intended
    6137/   15E78 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    6138/   15E78 :                     ; ---------------------------------------------------------------------------
    6139/   15E78 :                     
    6140/   15E78 : =$76FA6              RawColBlocks		equ CollArray1
    6141/   15E78 : =$76FA6              ConvRowColBlocks	equ CollArray1
    6142/   15E78 :                     
    6143/   15E78 :                     ; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
    6144/   15E78 :                     
    6145/   15E78 :                     
    6146/   15E78 :                     ConvertCollisionArray:
    6147/   15E78 : 4E75                		rts	
    6148/   15E7A :                     ; ---------------------------------------------------------------------------
    6149/   15E7A :                     		; The raw format stores the collision data column by column for the normal collision array.
    6150/   15E7A :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    6151/   15E7A : 43F9 0007 6FA6      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    6152/   15E80 : 45F9 0007 6FA6      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    6153/   15E86 :                     
    6154/   15E86 : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    6155/   15E8A :                     
    6156/   15E8A :                     .blockLoop:
    6157/   15E8A : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    6158/   15E8C :                     
    6159/   15E8C : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    6160/   15E90 :                     
    6161/   15E90 :                     .columnLoop:
    6162/   15E90 : 7800                		moveq	#0,d4
    6163/   15E92 :                     
    6164/   15E92 : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    6165/   15E96 :                     
    6166/   15E96 :                     .rowLoop:
    6167/   15E96 : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    6168/   15E98 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6169/   15E9A : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6170/   15E9C : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6171/   15EA0 :                     
    6172/   15EA0 : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6173/   15EA2 : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6174/   15EA6 : 5345                		subq.w	#1,d5			; Get next bit in the row
    6175/   15EA8 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6176/   15EAC :                     
    6177/   15EAC : D2FC 0020           		adda.w	#2*16,a1		; Next block
    6178/   15EB0 : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    6179/   15EB4 :                     
    6180/   15EB4 :                     		; This then converts the collision data into the final collision arrays
    6181/   15EB4 : 43F9 0007 6FA6      		lea	(ConvRowColBlocks).l,a1
    6182/   15EBA : 45F9 0007 7FA6      		lea	(CollArray2).l,a2	; Convert the row-converted collision block data into final rotated collision array
    6183/   15EC0 : 610C                		bsr.s	.convertArray
    6184/   15EC2 : 43F9 0007 6FA6      		lea	(RawColBlocks).l,a1
    6185/   15EC8 : 45F9 0007 6FA6      		lea	(CollArray1).l,a2	; Convert the raw collision block data into final normal collision array
    6186/   15ECE :                     
    6187/   15ECE :                     
    6188/   15ECE :                     .convertArray:
    6189/   15ECE : 363C 0FFF           		move.w	#$1000-1,d3		; Size of the collision array
    6190/   15ED2 :                     
    6191/   15ED2 :                     .processLoop:
    6192/   15ED2 : 7400                		moveq	#0,d2
    6193/   15ED4 : 323C 000F           		move.w	#$F,d1
    6194/   15ED8 : 3019                		move.w	(a1)+,d0		; Get current column of collision pixels
    6195/   15EDA : 6724                		beq.s	.noCollision		; Branch if there's no collision in this column
    6196/   15EDC : 6B0C                		bmi.s	.topPixelSolid		; Branch if top pixel of collision is solid
    6197/   15EDE :                     
    6198/   15EDE :                     	; Here we count, starting from the bottom, how many pixels tall
    6199/   15EDE :                     	; the collision in this column is.
    6200/   15EDE :                     .processColumnLoop1:
    6201/   15EDE : E248                		lsr.w	#1,d0
    6202/   15EE0 : 6402                		bhs.s	.pixelNotSolid1
    6203/   15EE2 : 5202                		addq.b	#1,d2
    6204/   15EE4 :                     
    6205/   15EE4 :                     .pixelNotSolid1:
    6206/   15EE4 : 51C9 FFF8           		dbf	d1,.processColumnLoop1
    6207/   15EE8 :                     
    6208/   15EE8 : 6018                		bra.s	.columnProcessed
    6209/   15EEA :                     ; ===========================================================================
    6210/   15EEA :                     
    6211/   15EEA :                     .topPixelSolid:
    6212/   15EEA : 0C40 FFFF           		cmpi.w	#$FFFF,d0		; Is entire column solid?
    6213/   15EEE : 670C                		beq.s	.entireColumnSolid	; Branch if so
    6214/   15EF0 :                     
    6215/   15EF0 :                     	; Here we count, starting from the top, how many pixels tall
    6216/   15EF0 :                     	; the collision in this column is (the resulting number is negative).
    6217/   15EF0 :                     .processColumnLoop2:
    6218/   15EF0 : E348                		lsl.w	#1,d0
    6219/   15EF2 : 6402                		bhs.s	.pixelNotSolid2
    6220/   15EF4 : 5302                		subq.b	#1,d2
    6221/   15EF6 :                     
    6222/   15EF6 :                     .pixelNotSolid2:
    6223/   15EF6 : 51C9 FFF8           		dbf	d1,.processColumnLoop2
    6224/   15EFA :                     
    6225/   15EFA : 6006                		bra.s	.columnProcessed
    6226/   15EFC :                     ; ===========================================================================
    6227/   15EFC :                     
    6228/   15EFC :                     .entireColumnSolid:
    6229/   15EFC : 303C 0010           		move.w	#$10,d0
    6230/   15F00 :                     
    6231/   15F00 :                     .noCollision:
    6232/   15F00 : 3400                		move.w	d0,d2
    6233/   15F02 :                     
    6234/   15F02 :                     .columnProcessed:
    6235/   15F02 : 14C2                		move.b	d2,(a2)+		; Store column collision height
    6236/   15F04 : 51CB FFCC           		dbf	d3,.processLoop
    6237/   15F08 :                     
    6238/   15F08 : 4E75                		rts	
    6239/   15F0A :                     
    6240/   15F0A :                     ; End of function ConvertCollisionArray
