(1) 3399/   87CC8 :                     ; ===========================================================================
(1) 3400/   87CC8 :                     ; Sets track volume.
(1) 3401/   87CC8 :                     ;
(1) 3402/   87CC8 :                     ; Has one parameter byte, the volume.
(1) 3403/   87CC8 :                     ;
(1) 3404/   87CC8 :                     ; For FM tracks, this is a 7-bit value from 0 (lowest volume) to 127 (highest
(1) 3405/   87CC8 :                     ; volume). The value is XOR'ed with 7Fh before being sent, then stripped of the
(1) 3406/   87CC8 :                     ; sign bit. The volume change takes effect immediately.
(1) 3407/   87CC8 :                     ;
(1) 3408/   87CC8 :                     ; For PSG tracks, this is a 4-bit value ranging from 8 (lowest volume) to 78h
(1) 3409/   87CC8 :                     ; (highest volume). The value is shifted 3 bits to the right, XOR'ed with 0Fh
(1) 3410/   87CC8 :                     ; and AND'ed with 0Fh before being uploaded, so the sign bit and the lower 3
(1) 3411/   87CC8 :                     ; bits are discarded.
(1) 3412/   87CC8 :                     ;
(1) 3413/   87CC8 :                     cfSetVolume:
(1) 3414/   87CC8 : 101C                	move.b	(a4)+,d0			; Load parameter byte
(1) 3415/   87CCA : 4600                	not.b	d0				; Invert bits
(1) 3416/   87CCC : 4A2D 0001           	tst.b	SMPS_Track.VoiceControl(a5)	; Is this a psg track?
(1) 3417/   87CD0 : 6A0A                	bpl.s	.FMVolume			; If not, branch
(1) 3418/   87CD2 : 0200 0078           	andi.b	#$78,d0
(1) 3419/   87CD6 : 1B40 0005           	move.b	d0,SMPS_Track.Volume(a5)	; Write volume
(1) 3420/   87CDA : 4E75                	rts
