    2855/    4FAA :                             if ((.__midpos<.__pos+5)||(.__midpos>.__endpos))
    2855/    4FAA :                                             .__midpos:      set             .__endpos
    2855/    4FAA :                             endif
    2855/    4FAA :                                     .__type:                set             substr("ResetDMAQueue/Transfers Function",.__pos+1+1,2)             ; .type
    2855/    4FAA :                     
    2855/    4FAA :                                     ; Expression is an effective address (e.g. %<.w d0 hex> )
    2855/    4FAA :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
    2855/    4FAA :                                             .__param:       set             substr("ResetDMAQueue/Transfers Function",.__midpos+1,.__endpos-.__midpos-1)        ; param
    2855/    4FAA :                     
