(2)   43/       0 :                     ; This is a macro that inserts code to output a sample when a certain number
(2)   44/       0 :                     ; of cycles have passed. The 'pCyclesToNextMacro' parameter is the number of
(2)   45/       0 :                     ; cycles until the next zCheckOutputSample macro.
(2)   46/       0 :                     zCheckOutputSample macro pAltRegs,pCyclesToNextMacro
(2)   47/       0 :                     	; Get the number of cycles until the next sample is due (relative to this macro)
(2)   48/       0 :                     zCurrentCycleDelta := zNextSampleCycle - zTotalCycles
(2)   49/       0 :                         if zCurrentCycleDelta < 0
(2)   50/       0 :                     zCurrentCycleDelta := -zCurrentCycleDelta
(2)   51/       0 :                         endif
(2)   52/       0 :                     
(2)   53/       0 :                     	; Get the number of cycles until the next sample is due (relative to the next zCheckOutputSample macro)
(2)   54/       0 :                     zNextCycleDelta := zNextSampleCycle - (zTotalCycles + pCyclesToNextMacro)
(2)   55/       0 :                         if zNextCycleDelta < 0
(2)   56/       0 :                     zNextCycleDelta := -zNextCycleDelta
(2)   57/       0 :                         endif
(2)   58/       0 :                     
(2)   59/       0 :                     	; If the sample is due closer to this macro than the next, then output a sample now
(2)   60/       0 :                         if (zCurrentCycleDelta < zNextCycleDelta) && (zSamplesWritten < zBatchSize)
(2)   61/       0 :                     zSamplesWritten := zSamplesWritten + 1
