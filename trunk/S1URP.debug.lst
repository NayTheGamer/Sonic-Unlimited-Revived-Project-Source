(1)  202/    1444 :                     ; ===========================================================================
(1)  203/    1444 :                     
(1)  204/    1444 :                     ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
(1)  205/    1444 :                     ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
(1)  206/    1444 :                     ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
(1)  207/    1444 :                     ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
(1)  208/    1444 :                     ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
(1)  209/    1444 :                     ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
(1)  210/    1444 :                     NemBCT_ShortCode:
(1)  211/    1444 : 1018                		move.b	(a0)+,d0	; get code
(1)  212/    1446 : E368                		lsl.w	d1,d0	; get index into code table
(1)  213/    1448 : D040                		add.w	d0,d0	; shift so that high bit is in bit position 7
(1)  214/    144A : 7A01                		moveq	#1,d5
(1)  215/    144C : E36D                		lsl.w	d1,d5
(1)  216/    144E : 5345                		subq.w	#1,d5	; d5 = 2^d1 - 1
(1)  217/    1450 :                     
(1)  218/    1450 :                     NemBCT_ShortCode_Loop:
(1)  219/    1450 : 3387 0000           		move.w	d7,(a1,d0.w)	; store entry
(1)  220/    1454 : 5440                		addq.w	#2,d0	; increment index
(1)  221/    1456 : 51CD FFF8           		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
(1)  222/    145A : 60BA                		bra.s	NemBCT_Loop
(1)  223/    145C :                     ; End of function NemDec_BuildCodeTable
