(2)  141/       0 :                     
(2)  142/       0 :                     	zCheckOutputSample 1,4
(2)  143/       0 :                     
(2)  144/       0 :                     	exx				; 4
(2)  145/       0 :                     
(2)  146/       0 :                     	zCheckOutputSample 0,4+4+15+10+4
