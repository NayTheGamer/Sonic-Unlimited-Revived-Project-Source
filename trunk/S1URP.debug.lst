    2855/    4F98 :   (MACRO-3)                          _KDebug.WriteLine       "ResetDMAQueue/Transfers Function"
    2855/    4F98 :    (MACRO-4)                         __FSTRING_GenerateArgumentsCode "ResetDMAQueue/Transfers Function"
    2855/    4F98 :                     
    2855/    4F98 : =$FFFFFFFFFFFFFFFF           .__pos: set     strstr("ResetDMAQueue/Transfers Function","%<")             ; token position
    2855/    4F98 : =$0                          .__sp:  set             0                                               ; stack displacement
    2855/    4F98 : ="ResetDMAQueue/..           .__str: set             "ResetDMAQueue/Transfers Function"
    2855/    4F98 :                     
    2855/    4F98 :                             ; Parse "ResetDMAQueue/Transfers Function" itself
    2855/    4F98 :                             while (.__pos>=0)
    2855/    4F98 :                     
    2855/    4F98 :                             ; Find the last occurance "%<" in the "ResetDMAQueue/Transfers Function"
    2855/    4F98 :                             while ( strstr(substr(.__str,.__pos+2,0),"%<")>=0 )
    2855/    4F98 :                                             .__pos:         set             strstr(substr(.__str,.__pos+2,0),"%<")+.__pos+2
    2855/    4F98 :                                     endm
    2855/    4F98 :                                     .__substr:      set             substr(.__str,.__pos,0)
    2855/    4F98 :                     
    2855/    4F98 :                                     ; Retrive expression in brackets following % char
    2855/    4F98 :                             .__endpos:      set             strstr(.__substr,">")
    2855/    4F98 :                                     if (.__endpos<0) ; Fix bizzare AS bug as stsstr() fails to check the last character of "ResetDMAQueue/Transfers Function"
    2855/    4F98 :                                             .__endpos:      set             strlen(.__substr)-1
    2855/    4F98 :                                     endif
    2855/    4F98 :                             .__midpos:      set             strstr(substr(.__substr,5,0)," ")
    2855/    4F98 :                             if ((.__midpos<0)||(.__midpos+5>.__endpos))
    2855/    4F98 :                                             .__midpos:      set             .__endpos
    2855/    4F98 :                                     else
    2855/    4F98 :                                             .__midpos:      set             .__midpos+5
    2855/    4F98 :                             endif
    2855/    4F98 :                                     .__type:                set             substr(.__substr,2,2)   ; .type
    2855/    4F98 :                     
    2855/    4F98 :                                     ; Expression is an effective address (e.g. %(.w d0 hex) )
    2855/    4F98 :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
    2855/    4F98 :                                             .__operand:     set             substr(.__substr,5,.__midpos-5)                                         ; ea
    2855/    4F98 :                                             .__param:       set             substr(.__substr,.__midpos+1,.__endpos-.__midpos-1)             ; param
    2855/    4F98 :                     
    2855/    4F98 :                                             if (.__type==".b")
    2855/    4F98 :                                                     subq.w  #2, sp
    2855/    4F98 :                                                     __FSTRING_PushArgument.b        .__operand,1(sp)
    2855/    4F98 :                                                     .__sp:  set             .__sp+2
    2855/    4F98 :                     
    2855/    4F98 :                                             elseif (.__type==".w")
    2855/    4F98 :                                                     __FSTRING_PushArgument.w        .__operand,-(sp)
    2855/    4F98 :                                                     .__sp:  set             .__sp+2
    2855/    4F98 :                     
    2855/    4F98 :                                             elseif (.__type==".l")
    2855/    4F98 :                                                     __FSTRING_PushArgument.l        .__operand,-(sp)
    2855/    4F98 :                                                     .__sp:  set             .__sp+4
    2855/    4F98 :                     
    2855/    4F98 :                                             else
    2855/    4F98 :                                                     error "Unrecognized type in "ResetDMAQueue/Transfers Function" operand: \{.__type}"
    2855/    4F98 :                                             endif
    2855/    4F98 :                     
    2855/    4F98 :                                     endif
    2855/    4F98 :                     
    2855/    4F98 :                                     ; Cut "ResetDMAQueue/Transfers Function"
