    3669/    7094 :                     
    3670/    7094 :                     ; Draws a block's worth of tiles
    3671/    7094 :                     ; Parameters:
    3672/    7094 :                     ; a0 = Pointer to block metadata (block index and X/Y flip)
    3673/    7094 :                     ; a1 = Pointer to block
    3674/    7094 :                     ; a5 = Pointer to VDP command port
    3675/    7094 :                     ; a6 = Pointer to VDP data port
    3676/    7094 :                     ; d0 = VRAM command to access plane
    3677/    7094 :                     ; d2 = VRAM plane A/B specifier
    3678/    7094 :                     ; d7 = Plane row delta
