    4070/    7302 : (MACRO)              		KDebug.WriteLine "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"		
    4070/    7302 : 40E7                                move.w  sr, -(sp)
    4070/    7304 :  (MACRO-2)                           _KDebug.WriteLine       "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"
    4070/    7304 :   (MACRO-3)                          __FSTRING_GenerateArgumentsCode "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"
    4070/    7304 :                     
    4070/    7304 : =$22                         .__pos: set     strstr("LevelLayoutLoad(): Loaded layout: %<.l a0 sym>","%<")             ; token position
    4070/    7304 : =$0                          .__sp:  set             0                                               ; stack displacement
    4070/    7304 : ="LevelLayoutLoa..           .__str: set             "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"
    4070/    7304 :                     
    4070/    7304 :                             ; Parse "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>" itself
    4070/    7304 :                             while (.__pos>=0)
    4070/    7304 :                     
    4070/    7304 :                             ; Find the last occurance "%<" in the "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"
    4070/    7304 :                             while ( strstr(substr(.__str,.__pos+2,0),"%<")>=0 )
    4070/    7304 :                                             .__pos:         set             strstr(substr(.__str,.__pos+2,0),"%<")+.__pos+2
    4070/    7304 :                                     endm
    4070/    7304 :                                     .__substr:      set             substr(.__str,.__pos,0)
    4070/    7304 :                     
    4070/    7304 :                                     ; Retrive expression in brackets following % char
    4070/    7304 :                             .__endpos:      set             strstr(.__substr,">")
    4070/    7304 :                                     if (.__endpos<0) ; Fix bizzare AS bug as stsstr() fails to check the last character of "LevelLayoutLoad(): Loaded layout: %<.l a0 sym>"
    4070/    7304 :                                             .__endpos:      set             strlen(.__substr)-1
    4070/    7304 :                                     endif
    4070/    7304 :                             .__midpos:      set             strstr(substr(.__substr,5,0)," ")
    4070/    7304 :                             if ((.__midpos<0)||(.__midpos+5>.__endpos))
    4070/    7304 :                                             .__midpos:      set             .__endpos
    4070/    7304 :                                     else
    4070/    7304 :                                             .__midpos:      set             .__midpos+5
    4070/    7304 :                             endif
    4070/    7304 :                                     .__type:                set             substr(.__substr,2,2)   ; .type
    4070/    7304 :                     
    4070/    7304 :                                     ; Expression is an effective address (e.g. %(.w d0 hex) )
    4070/    7304 :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
    4070/    7304 :                                             .__operand:     set             substr(.__substr,5,.__midpos-5)                                         ; ea
    4070/    7304 :                                             .__param:       set             substr(.__substr,.__midpos+1,.__endpos-.__midpos-1)             ; param
