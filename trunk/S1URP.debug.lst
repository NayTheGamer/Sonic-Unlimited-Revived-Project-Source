    2704/    4AD0 : (MACRO)                      ResetDMAQueue		
    2704/    4AD0 :                     ;       move.w  #VDP_Command_Buffer,(VDP_Command_Buffer_Slot).w
    2704/    4AD0 : 4278 C800                       clr.w       (VDP_Command_Buffer).w
    2704/    4AD4 : 21FC FFFF C800                  move.l      #VDP_Command_Buffer,(VDP_Command_Buffer_Slot).w         
             4ADA : C8FC             
    2704/    4ADC :  (MACRO-2)                   KDebug.WriteLine "ResetDMAQueue/Transfers Function"             
    2704/    4ADC : 40E7                                move.w  sr, -(sp)
    2704/    4ADE :   (MACRO-3)                          _KDebug.WriteLine       "ResetDMAQueue/Transfers Function"
    2704/    4ADE :    (MACRO-4)                         __FSTRING_GenerateArgumentsCode "ResetDMAQueue/Transfers Function"
    2704/    4ADE :                     
    2704/    4ADE : =$FFFFFFFFFFFFFFFF           .__pos: set     strstr("ResetDMAQueue/Transfers Function","%<")             ; token position
    2704/    4ADE : =$0                          .__sp:  set             0                                               ; stack displacement
    2704/    4ADE : ="ResetDMAQueue/..           .__str: set             "ResetDMAQueue/Transfers Function"
    2704/    4ADE :                     
    2704/    4ADE :                             ; Parse "ResetDMAQueue/Transfers Function" itself
    2704/    4ADE :                             while (.__pos>=0)
    2704/    4ADE :                     
    2704/    4ADE :                             ; Find the last occurance "%<" in the "ResetDMAQueue/Transfers Function"
    2704/    4ADE :                             while ( strstr(substr(.__str,.__pos+2,0),"%<")>=0 )
    2704/    4ADE :                                             .__pos:         set             strstr(substr(.__str,.__pos+2,0),"%<")+.__pos+2
    2704/    4ADE :                                     endm
    2704/    4ADE :                                     .__substr:      set             substr(.__str,.__pos,0)
    2704/    4ADE :                     
    2704/    4ADE :                                     ; Retrive expression in brackets following % char
    2704/    4ADE :                             .__endpos:      set             strstr(.__substr,">")
    2704/    4ADE :                                     if (.__endpos<0) ; Fix bizzare AS bug as stsstr() fails to check the last character of "ResetDMAQueue/Transfers Function"
    2704/    4ADE :                                             .__endpos:      set             strlen(.__substr)-1
    2704/    4ADE :                                     endif
    2704/    4ADE :                             .__midpos:      set             strstr(substr(.__substr,5,0)," ")
    2704/    4ADE :                             if ((.__midpos<0)||(.__midpos+5>.__endpos))
    2704/    4ADE :                                             .__midpos:      set             .__endpos
    2704/    4ADE :                                     else
    2704/    4ADE :                                             .__midpos:      set             .__midpos+5
    2704/    4ADE :                             endif
    2704/    4ADE :                                     .__type:                set             substr(.__substr,2,2)   ; .type
    2704/    4ADE :                     
    2704/    4ADE :                                     ; Expression is an effective address (e.g. %(.w d0 hex) )
    2704/    4ADE :                                     if ((strlen(.__type)==2)&&(substr(.__type,0,1)=="."))
    2704/    4ADE :                                             .__operand:     set             substr(.__substr,5,.__midpos-5)                                         ; ea
    2704/    4ADE :                                             .__param:       set             substr(.__substr,.__midpos+1,.__endpos-.__midpos-1)             ; param
    2704/    4ADE :                     
    2704/    4ADE :                                             if (.__type==".b")
    2704/    4ADE :                                                     subq.w  #2, sp
    2704/    4ADE :                                                     __FSTRING_PushArgument.b        .__operand,1(sp)
    2704/    4ADE :                                                     .__sp:  set             .__sp+2
    2704/    4ADE :                     
    2704/    4ADE :                                             elseif (.__type==".w")
    2704/    4ADE :                                                     __FSTRING_PushArgument.w        .__operand,-(sp)
    2704/    4ADE :                                                     .__sp:  set             .__sp+2
    2704/    4ADE :                     
    2704/    4ADE :                                             elseif (.__type==".l")
    2704/    4ADE :                                                     __FSTRING_PushArgument.l        .__operand,-(sp)
    2704/    4ADE :                                                     .__sp:  set             .__sp+4
    2704/    4ADE :                     
    2704/    4ADE :                                             else
    2704/    4ADE :                                                     error "Unrecognized type in "ResetDMAQueue/Transfers Function" operand: \{.__type}"
    2704/    4ADE :                                             endif
    2704/    4ADE :                     
    2704/    4ADE :                                     endif
    2704/    4ADE :                     
    2704/    4ADE :                                     ; Cut "ResetDMAQueue/Transfers Function"
